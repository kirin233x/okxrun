# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- OKX credentials -------------------------------------------------------
# Create these on the SUB-ACCOUNT that holds the trading balance.
# Permissions: enable "Trade". Do NOT enable "Withdraw".
# Bind the key to your VPS's outbound IP.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# 1 = OKX demo trading (paper). 0 = real money.
OKX_SIMULATED=0

# 1 = compute and log orders but send nothing. Leave at 1 until a `plan` run
# looks right to you, then set to 0.
OKX_DRY_RUN=1

# --- Strategy --------------------------------------------------------------
# The executor sizes off the sub-account's own balance, so there is no capital
# setting: whatever is in the account is what it trades.
OKXRUN_VARIANT=r9.2
# Start at 1. Raise only after live results have been compared to the backtest.
OKXRUN_LEVERAGE=1.0

# --- Hard limits -----------------------------------------------------------
# Enforced locally before any request is signed. A sizing bug is rejected here
# rather than at the exchange. Set these deliberately for your balance.
OKXRUN_MAX_GROSS_LEVERAGE=1.5
OKXRUN_MAX_INSTRUMENT_NOTIONAL_USDT=200
OKXRUN_MAX_ORDER_NOTIONAL_USDT=200
OKXRUN_MAX_ORDERS_PER_HOUR=40
OKXRUN_MIN_EQUITY_USDT=100
OKXRUN_DAILY_KILL_LOSS=0.03

# --- Timing ----------------------------------------------------------------
OKXRUN_REBALANCE_MINUTE_UTC=2
OKXRUN_FAST_LOOP_SECONDS=60

# --- Paths -----------------------------------------------------------------
# Creating the HALT file flattens every position and stops new risk:
#   touch state/HALT
OKXRUN_STATE_DIR=state
OKXRUN_HALT_FILE=state/HALT
